{
  "name": "synth-persona",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "통계청 인구총조사 분포 기반 합성 패널로 아이디어를 0차 시장검증 — 세그먼트 유의성 게이트·LLM 관련성 게이트·Nemotron 서사 페르소나를 갖춘 리포트 엔진",
  "keywords": [
    "synthetic-panel",
    "market-validation",
    "survey-simulation",
    "korea",
    "kosis",
    "persona",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Choihello/synth-persona.git"
  },
  "homepage": "https://synth-persona-app.vercel.app",
  "bugs": "https://github.com/Choihello/synth-persona/issues",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "data/census",
    "data/nemotron",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "synth-persona": "dist/cli/main.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "build": "tsup",
    "calibrate:demo": "node dist/eval/calibrate-demo.js",
    "fidelity:demo": "node dist/eval/fidelity-demo.js",
    "reliability:demo": "node dist/eval/reliability-demo.js",
    "report:demo": "node dist/eval/report-demo.js",
    "b2:live": "node dist/eval/b2-live.js",
    "report:live": "node dist/eval/report-live.js",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.13.2",
    "fast-check": "^3.22.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "workspaces": ["web", "app"]
}
